# Obtenha a URL em Neon > inpasa-projetos-arquitetura > Connection Details
DATABASE_URL=postgresql://USER:PASSWORD@HOST/inpasa_projetos_arquitetura?sslmode=require
# SOMENTE PARA DEMONSTRAÇÃO; para produção, use false e configure Entra
ENABLE_DEMO_AUTH=true
# PRODUÇÃO: tenant corporativo e audience (Application ID URI ou client-id da API)
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
# Cliente público MSAL (se desejar entrar pelo Entra em vez do seletor demo)
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_API_SCOPE=
NEXT_PUBLIC_API_BASE_URL=
# Origens HTTPS permitidas a consumir a API (Power Apps Code Apps, por exemplo)
ALLOWED_ORIGINS=
